# ==============================================================================
# Cram Environment Configuration
# ==============================================================================
# Port on which the Express server and MCP endpoint will listen
PORT=3000

# Google Gemini API Key (Free tier from https://aistudio.google.com/)
# Used for quiz generation, intelligent answer grading, and study plan customization.
# If omitted, Cram automatically falls back to GROQ_API_KEY, or a deterministic mock engine.
GEMINI_API_KEY=

# Optional: Groq Cloud API Key (Free tier from https://console.groq.com/)
# Used as high-speed fallback provider if GEMINI_API_KEY is not set or rate-limited.
GROQ_API_KEY=

# Optional: Bearer authentication token for the MCP server (/mcp endpoint)
# When set, any client request to /mcp must include header `Authorization: Bearer <MCP_AUTH_TOKEN>`.
# Leave empty for local development and demo purposes.
MCP_AUTH_TOKEN=

# SQLite database file path. Directory will be created automatically if it doesn't exist.
DB_PATH=./data/cram.db

# Public URL base for this server (used for MCP resource URIs and reverse proxies)
PUBLIC_BASE_URL=http://localhost:3000

# Comma-separated list of allowed Origins for browser requests and DNS rebinding protection
ALLOWED_ORIGINS=http://localhost:3000
